# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# secrets / credentials — NEVER commit these
firebase-service-account.json
*service-account*.json
*serviceaccount*.json
*.key.json
license.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# electron packaging
/dist-electron
# portable PostgreSQL binaries bundled into the installer (see MANUAL_Setup_Installation.md)
/pgsql
# portable macOS PostgreSQL binaries (see PLAN_2026-09-08-macos-support.md Phase 2b)
/pgsql-mac
# local database cluster
/pg_data

# marketing/ is its own separate git checkout (public GitHub Pages repo) —
# never nest it inside this private app repo
/marketing

# tool caches
/.graphify/
# graphify analysis output — generated, never part of the app release
/graphify-out/
.graphifyignore


# Claude Code local state — machine-specific, never commit
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# Portable cloudflared for Plus installers — see MANUAL_Setup_Installation.md §1
cloudflared/
cloudflared-mac/

# storefront/ — separate deployable service (own dependency tree); the
# root-anchored /node_modules and /.next rules above don't reach this nested folder
/storefront/node_modules
/storefront/.next
