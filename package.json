{
  "name": "white-van-ops",
  "version": "0.1.0",
  "author": {
    "name": "WhiteVanOps Dev Team",
    "email": "dev@whitevanops.com"
  },
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "node scripts/electron-dev.js",
    "electron:build": "node scripts/electron-build.js --base",
    "electron:build:plus": "node scripts/electron-build.js --plus",
    "electron:build:trial": "node scripts/electron-build.js --trial --plan base",
    "electron:build:trial:plus": "node scripts/electron-build.js --trial --plan plus",
    "electron:build:mac": "node scripts/electron-build.js --mac --base",
    "electron:build:mac:plus": "node scripts/electron-build.js --mac --plus",
    "electron:build:mac:trial": "node scripts/electron-build.js --mac --trial --plan base",
    "electron:build:mac:trial:plus": "node scripts/electron-build.js --mac --trial --plan plus",
    "prepare": "husky"
  },
  "build": {
    "appId": "com.whitevanops.app",
    "productName": "WhiteVanOps",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "nextjs"
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "nextjs/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/db",
        "to": "db"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/app/favicon.ico",
      "extraResources": [
        {
          "from": "pgsql",
          "to": "pgsql"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WhiteVanOps"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "WhiteVanOps hosts the field-tech app on your local network so phones on the same WiFi can log time and view jobs."
      },
      "extraResources": [
        {
          "from": "pgsql-mac",
          "to": "pgsql"
        }
      ]
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "firebase": "^12.15.0",
    "node-cron": "^4.5.0",
    "node-machine-id": "^1.1.12",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "exceljs": "^4.4.0",
    "firebase-admin": "^14.1.0",
    "husky": "^9.1.7",
    "jose": "^6.2.3",
    "lucide-react": "^1.21.0",
    "next": "16.2.4",
    "papaparse": "^5.5.4",
    "pdf-lib": "^1.17.1",
    "png-to-ico": "^3.0.1",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
